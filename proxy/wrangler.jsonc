{
  // Projet Cloudflare Pages « signature-proxy » : sert signature.baule.fr (DNS chez OVH, simple CNAME)
  // et transmet tout au Worker « signaturepdf-cloudflare » par liaison de service.
  "name": "signature-proxy",
  "compatibility_date": "2025-09-01",
  "pages_build_output_dir": ".",
  "services": [
    { "binding": "APP", "service": "signaturepdf-cloudflare" }
  ]
}

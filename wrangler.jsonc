{
  "name": "signaturepdf-cloudflare",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // Pages et fichiers statiques (générés par `npm run build`)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/", "/index.html", "/login", "/logout", "/_pages/*", "/signature", "/signature/*", "/organization", "/metadata", "/shares"]
  },

  // Index des partages (remplace l'id après `npx wrangler d1 create signaturepdf`)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signaturepdf",
      "database_id": "1b4cc485-fc4a-43c0-99fa-7b9601247357",
      "migrations_dir": "migrations"
    }
  ],

  // Contenu chiffré des PDF et des signatures (remplace l'id après `npx wrangler kv namespace create BLOBS`)
  "kv_namespaces": [
    { "binding": "BLOBS", "id": "bb19bbfbf81f44de8646cd52ed0e79be" }
  ],

  // Purge des partages expirés, toutes les heures
  "triggers": { "crons": ["17 * * * *"] },


  // Limitation des essais de mot de passe (page /login et en-tête de partage) : 5 essais par minute et par IP
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Liaison de service vers le Worker « notify » (serveur de notifications compatible Gotify) : appel direct, sans passer par le réseau public
  "services": [
    { "binding": "NOTIFY", "service": "notify" }
  ],
  "vars": {
    "MAX_BYTES": "20000000",      // taille max d'un PDF partagé (octets)
    "MAX_LAYERS": "30",           // signatures max par document
    "MAX_SHARES": "300",          // documents partagés actifs max
    "TOTAL_BYTES": "800000000"    // stockage total max (KV gratuit = 1 Go)
  }
}
